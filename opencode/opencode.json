{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "timeout": 30000
    },
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:TAVILY_API_KEY}"
      },
      "enabled": true,
      "timeout": 30000
    }
  },

  "lsp": true,
  "snapshot": true,
  "share": "disabled",
  "subagent_depth": 1,

  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 4,
    "reserved": 12000
  },

  "tool_output": {
    "max_lines": 500,
    "max_bytes": 51200
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "coverage/**",
      ".terraform/**"
    ]
  },

  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*terraform.tfstate*": "deny",
      "*.pem": "deny",
      "id_*": "deny",
      "**/id_*": "deny"
    },
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "task": "allow",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status --short": "allow",
      "git diff": "allow",
      "git diff --cached": "allow",
      "git diff --check": "allow",
      "git diff --stat": "allow",
      "git log --oneline -10": "allow",
      "git branch --show-current": "allow",
      "make check": "allow",
      "npm test": "allow",
      "npm test *": "allow",
      "pytest": "allow",
      "pytest *": "allow",
      "ruff": "allow",
      "ruff *": "allow",
      "mypy": "allow",
      "mypy *": "allow",
      "go test": "allow",
      "go test *": "allow",
      "terraform validate": "allow",
      "terraform validate *": "allow",
      "git push": "deny",
      "git push *": "deny",
      "git reset --hard": "deny",
      "git reset --hard *": "deny",
      "git clean": "deny",
      "git clean *": "deny",
      "rm -rf *": "deny",
      "terraform apply": "deny",
      "terraform apply *": "deny",
      "terraform destroy": "deny",
      "terraform destroy *": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/.env*": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.azure/**": "deny",
      "**/terraform.tfstate*": "deny",
      "**/*.pem": "deny",
      "**/id_*": "deny"
    },
    "websearch": "ask",
    "webfetch": "allow",
    "question": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "doom_loop": "ask"
  }
}
