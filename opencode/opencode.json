{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "opencode-gemini-auth@latest"
    ],
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            }
        },
        "tavily": {
            "type": "remote",
            "url": "https://mcp.tavily.com/mcp",
            "oauth": false,
            "headers": {
                "Authorization": "Bearer {env:TAVILY_API_KEY}"
            },
            "enabled": true
        },
    },
    "lsp": {
        "lua": {
            "command": [
                "/Users/anton/.local/share/nvim/mason/bin/lua-language-server"
            ],
            "extensions": [
                ".lua"
            ],
            "initialization": {
                "Lua": {
                    "workspace": {
                        "checkThirdParty": false
                    }
                }
            }
        },
        "css": {
            "command": [
                "/Users/anton/.local/share/nvim/mason/bin/vscode-css-language-server",
                "--stdio"
            ],
            "extensions": [
                ".css",
                ".scss",
                ".less"
            ]
        },
        "go": {
            "command": [
                "/Users/anton/.local/share/nvim/mason/bin/gopls",
                "--stdio"
            ],
            "extensions": [
                ".go",
                ".gomod",
                ".gowork",
                ".gotmpl",
                ".gosum"
            ]
        },
        "html": {
            "command": [
                "/Users/anton/.local/share/nvim/mason/bin/vscode-html-language-server",
                "--stdio"
            ],
            "extensions": [
                ".html",
                ".blade",
                ".jsx",
                ".tsx",
                ".svelte"
            ]
        },
        "json": {
            "command": [
                "/Users/anton/.local/share/nvim/mason/bin/vscode-json-language-server",
                "--stdio"
            ],
            "extensions": [
                ".json",
                ".jsonc"
            ]
        },
        "python": {
            "command": [
                "/Users/anton/.local/share/nvim/mason/bin/pylsp"
            ],
            "extensions": [
                ".py"
            ]
        },
        "svelte": {
            "command": [
                "/Users/anton/.local/share/nvim/mason/bin/svelteserver",
                "--stdio"
            ],
            "extensions": [
                ".svelte"
            ]
        },
        "tailwindcss": {
            "command": [
                "/Users/anton/.local/share/nvim/mason/bin/tailwindcss-language-server",
                "--stdio"
            ],
            "extensions": [
                ".html",
                ".css",
                ".scss",
                ".less",
                ".js",
                ".ts",
                ".jsx",
                ".tsx",
                ".vue",
                ".svelte",
                ".astro",
                ".php",
                ".md",
                ".mdx"
            ]
        },
        "ts": {
            "command": [
                "/Users/anton/.local/share/nvim/mason/bin/typescript-language-server",
                "--stdio"
            ],
            "extensions": [
                ".js",
                ".jsx",
                ".ts",
                ".tsx",
                ".mjs",
                ".cjs"
            ]
        },
        "terraform": {
            "command": [
                "/Users/anton/.local/share/nvim/mason/bin/terraform-ls",
                "serve"
            ],
            "extensions": [
                ".tf",
                ".tfvars",
                ".hcl"
            ]
        }
    },
    "formatter": {
        "prettier": {
            "command": [
                "/Users/anton/.local/share/nvim/mason/bin/prettier",
                "--write",
                "$FILE"
            ],
            "extensions": [
                ".js",
                ".ts",
                ".jsx",
                ".tsx",
                ".json",
                ".md",
                ".css",
                ".scss",
                ".html",
                ".yaml",
                ".yml",
                ".svelte",
                ".vue"
            ]
        },
        "black": {
            "command": [
                "/Users/anton/.local/share/nvim/mason/bin/black",
                "$FILE"
            ],
            "extensions": [
                ".py"
            ]
        },
        "isort": {
            "command": [
                "/Users/anton/.local/share/nvim/mason/bin/isort",
                "$FILE"
            ],
            "extensions": [
                ".py"
            ]
        },
        "terraform": {
            "command": [
                "/Users/anton/.local/share/nvim/mason/bin/terraform",
                "$FILE"
            ],
            "extensions": [
                ".tf",
                ".tfvars",
                ".hcl"
            ]
        }
    }
}
