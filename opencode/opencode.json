{
  "$schema": "https://opencode.ai/config.json",

  "model": "opencode-go/deepseek-v4.1-flash",
  "agents": {
    "title": { "model": "opencode-go/deepseek-v4-flash" }
  },

  "providers": {
    "openai": {
      "settings": {
        "compaction": { "type": "native" }
      }
    }
  },

  "share": "disabled",
  "snapshots": true,
  "formatter": true,
  "update": "notify",
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },

  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 24000
    },
    "buffer": 20000
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "coverage/**",
      ".terraform/**"
    ]
  },

  "experimental": {
    "subagent_depth": 2
  },

  "worktree": {
    "directory": ".lane/trees"
  },

  "websearch": {
    "provider": "random"
  },

  "mcp": {
    "timeout": {
      "startup": 45000,
      "catalog": 30000,
      "execution": 600000
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "tavily": {
        "type": "remote",
        "url": "https://mcp.tavily.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:TAVILY_API_KEY}"
        }
      }
    }
  },

  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*terraform.tfstate*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "id_*", "effect": "deny" },
    { "action": "read", "resource": "**/id_*", "effect": "deny" },

    { "action": "edit", "resource": "*", "effect": "ask" },

    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },

    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git branch --show-current", "effect": "allow" },
    { "action": "shell", "resource": "make check", "effect": "allow" },
    { "action": "shell", "resource": "npm test *", "effect": "allow" },
    { "action": "shell", "resource": "pytest *", "effect": "allow" },
    { "action": "shell", "resource": "ruff *", "effect": "allow" },
    { "action": "shell", "resource": "mypy *", "effect": "allow" },
    { "action": "shell", "resource": "go test *", "effect": "allow" },
    { "action": "shell", "resource": "terraform validate *", "effect": "allow" },

    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "command -v *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },

    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "terraform apply *", "effect": "deny" },
    { "action": "shell", "resource": "terraform destroy *", "effect": "deny" },

    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.env*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.azure/*", "effect": "deny" },
    { "action": "external_directory", "resource": "**/terraform.tfstate*", "effect": "deny" },
    { "action": "external_directory", "resource": "**/*.pem", "effect": "deny" },
    { "action": "external_directory", "resource": "**/id_*", "effect": "deny" },

    { "action": "websearch", "resource": "*", "effect": "ask" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "doom_loop", "resource": "*", "effect": "ask" },

    { "action": "jev_*", "resource": "*", "effect": "allow" },
    { "action": "cost-estimate", "resource": "*", "effect": "allow" }
  ]
}
