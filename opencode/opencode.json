{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:TAVILY_API_KEY}"
      },
      "enabled": true
    }
  },

  "lsp": true,

  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*terraform.tfstate*": "deny",
      "*.pem": "deny",
      "id_*": "deny",
      "**/id_*": "deny"
    },
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "task": "allow",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status --short": "allow",
      "git diff": "allow",
      "git diff --cached": "allow",
      "git diff --check": "allow",
      "git diff --stat": "allow",
      "git log --oneline -10": "allow",
      "git branch --show-current": "allow",
      "make check": "allow",
      "npm test *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "mypy *": "allow",
      "go test *": "allow",
      "terraform validate *": "allow",
      "git push *": "deny",
      "git reset --hard *": "deny",
      "terraform apply *": "deny",
      "terraform destroy *": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/.env*": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.azure/**": "deny",
      "**/terraform.tfstate*": "deny",
      "**/*.pem": "deny",
      "**/id_*": "deny"
    },
    "websearch": "ask",
    "webfetch": "allow",
    "question": "allow",
    "todowrite": "allow",
    "skill": "allow"
  }
}
