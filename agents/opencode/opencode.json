{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "share": "disabled",
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*terraform.tfstate*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.pem",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "id_*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/id_*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "terraform apply *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "terraform destroy *",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/.env*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.aws/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.azure/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "**/terraform.tfstate*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "**/*.pem",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "**/id_*",
      "effect": "deny"
    }
  ]
}
